# Copy to .env and adjust. Never commit .env or put credentials here.
# Relative paths resolve against the directory containing the mr-review binary.

# Root of the main project (git working copy). Empty = auto-detect (git parent, then single sibling repo with CLAUDE.md/.claude).
PROJECT_ROOT=

HOST=127.0.0.1
PORT=8765
# Open the browser automatically when started without arguments (1/0).
OPEN_BROWSER=1

DATABASE_PATH=./data/reviews.sqlite
LOG_DIR=./logs
RUNTIME_DIR=./runtime

# Project-local review skill/agent/command name. Empty = auto (prefers "mr-review").
REVIEW_SKILL=

# Runners. Anything not found in PATH is simply hidden from the UI.
CLAUDE_BIN=claude
# Models offered in the UI for Claude Code; the first one is the default. Empty entry = project/CLI default.
CLAUDE_MODELS=default,fable,opus,sonnet
CLAUDE_MAX_BUDGET_USD=
CODEX_BIN=codex
CODEX_MODELS=default,gpt-5-codex
DEFAULT_RUNNER=claude
RUN_TIMEOUT_SEC=1800
# Extra tools allowed for read-only Claude runs, space separated (e.g. "Bash(php *)").
CLAUDE_EXTRA_ALLOWED_TOOLS=

GLAB_BIN=glab
# Host and project path of the code repository. Empty = derived from `git remote get-url origin`.
GITLAB_HOST=
GITLAB_PROJECT=
GITLAB_SYNC_ROLES=reviewer,assignee
GITLAB_SYNC_ONLY_PROJECT=1

# Branch that new task branches start from, and where worktrees are created.
BASE_BRANCH=develop
WORKTREE_DIR=./runtime/worktrees

RUN_CONCURRENCY=1
