# Copy to .env and adjust. Never commit .env or put credentials here.
# Relative paths resolve against the directory containing the mr-review binary.

# Root of the main project (git working copy). Empty = auto-detect (git parent, then single sibling repo with CLAUDE.md/.claude).
PROJECT_ROOT=

HOST=127.0.0.1
PORT=8765
# Open the browser automatically when started without arguments (1/0).
OPEN_BROWSER=1

DATABASE_PATH=./data/reviews.sqlite
LOG_DIR=./logs
RUNTIME_DIR=./runtime

# Project skills per dashboard action (see docs/SKILLS.md). Every action first looks for a project-local
# agent / command / skill with this name under .claude/; empty = the default name shown in the comment.
# Comments must stay on their own lines: the parser keeps everything after "=" as the value.
# review_full: default mr-review (REVIEW_SKILL is a legacy alias of this variable)
SKILL_REVIEW_FULL=
# review_quick: default mr-review-quick; falls back to the full-review skill
SKILL_REVIEW_QUICK=
# review_verify: default mr-review-verify; falls back to the full-review skill
SKILL_REVIEW_VERIFY=
# fix_comments: default mr-fix-comments
SKILL_FIX_COMMENTS=
# plan: default task-plan
SKILL_PLAN=
# implement: default task-implement
SKILL_IMPLEMENT=

# Runners. Anything not found in PATH is simply hidden from the UI.
CLAUDE_BIN=claude
# Models offered in the UI for Claude Code; the first one is the default. Empty entry = project/CLI default.
CLAUDE_MODELS=default,fable,opus,sonnet
CLAUDE_MAX_BUDGET_USD=
CODEX_BIN=codex
CODEX_MODELS=default,gpt-5-codex
DEFAULT_RUNNER=claude
RUN_TIMEOUT_SEC=1800
# Extra tools allowed for read-only Claude runs, space separated (e.g. "Bash(php *)").
CLAUDE_EXTRA_ALLOWED_TOOLS=
# How Claude Code decides permissions. Whatever would prompt in a terminal is shown in the dashboard as
# "Нужен ваш ответ" and you allow/deny it there. Read-only runs always get the project root read-only for the
# shell and never edit files.
#   auto   (default) the agent's own classifier decides most calls itself; it asks only what it cannot judge
#   manual           classic mode: project/user permission rules apply, everything else is asked
#   strict           fixed allow/deny tool lists of earlier versions; nothing is asked, unknown calls are denied
CLAUDE_PERMISSIONS=auto
# Seconds a run waits for your answer to a permission prompt before treating it as denied.
APPROVAL_TIMEOUT_SEC=1800
# Where "Сохранить план в проект" writes markdown plans. Empty = <PROJECT_ROOT>/.claude/plans.
PLANS_DIR=

GLAB_BIN=glab
# Host and project path of the code repository. Empty = derived from `git remote get-url origin`.
GITLAB_HOST=
GITLAB_PROJECT=
GITLAB_SYNC_ROLES=reviewer,assignee,author
GITLAB_SYNC_ONLY_PROJECT=1

# Branch that new task branches start from, and where worktrees are created.
BASE_BRANCH=develop
WORKTREE_DIR=./runtime/worktrees

# Agents running at the same time. Runs on different MRs/tasks go in parallel; the same MR/task never runs twice at once.
RUN_CONCURRENCY=4
